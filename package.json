{
  "name": "pbz-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm --workspace @pbz/desktop run build",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:rust",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "desktop": "npm --workspace @pbz/desktop run tauri -- dev",
    "desktop:build": "npm --workspace @pbz/desktop run tauri -- build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npm --workspace @pbz/desktop run test",
    "typecheck": "npm --workspace @pbz/desktop run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "typescript": "^5.8.3"
  }
}
